{
  "info": {
    "name": "VinhKhanh Explorer API",
    "description": "Postman Collection for VinhKhanh Explorer Backend (.NET 10). Tests Owner, Admin, TTS, POI, Menu, QR, and Quiz functionality.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Owner",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"]},
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"chuquan01\",\n  \"email\": \"chuquan01@test.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Chủ Quán 01\"\n}"}
          }
        },
        {
          "name": "Login Owner",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"chuquan01\",\n  \"password\": \"Password123!\"\n}"}
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "admin", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"}
          }
        }
      ]
    },
    {
      "name": "2. Admin CMS",
      "item": [
        {
          "name": "Get Pending Owners",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/owners/pending", "host": ["{{baseUrl}}"], "path": ["api", "admin", "owners", "pending"]}
          }
        },
        {
          "name": "Approve Owner",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/owners/1/approve", "host": ["{{baseUrl}}"], "path": ["api", "admin", "owners", "1", "approve"]}
          }
        },
        {
          "name": "Get Pending POIs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/pois/pending", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pois", "pending"]}
          }
        },
        {
          "name": "Approve POI",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/pois/1/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pois", "1", "status"]},
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}"}
          }
        },
        {
          "name": "Generate QR",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/pois/1/generate-qr", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pois", "1", "generate-qr"]}
          }
        },
        {
          "name": "Create Quiz",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/quiz", "host": ["{{baseUrl}}"], "path": ["api", "admin", "quiz"]},
            "body": {"mode": "raw", "raw": "{\n  \"poiId\": 1,\n  \"questionText\": \"Món ăn nào nổi tiếng nhất ở Vĩnh Khánh?\",\n  \"answerA\": \"Ốc\",\n  \"answerB\": \"Phở\",\n  \"answerC\": \"Cơm Tấm\",\n  \"answerD\": \"Bún Chả\",\n  \"correctOption\": \"A\",\n  \"explanationText\": \"Ốc là đặc sản nổi tiếng khu vực quận 4.\"\n}"}
          }
        },
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/admin/audit-logs", "host": ["{{baseUrl}}"], "path": ["api", "admin", "audit-logs"]}
          }
        }
      ]
    },
    {
      "name": "3. Owner Features",
      "item": [
        {
          "name": "Get My POIs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/owner/pois", "host": ["{{baseUrl}}"], "path": ["api", "owner", "pois"]}
          }
        },
        {
          "name": "Create POI",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/owner/pois", "host": ["{{baseUrl}}"], "path": ["api", "owner", "pois"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Quán Ốc Test\",\n  \"latitude\": 10.760123,\n  \"longitude\": 106.702345,\n  \"category\": \"restaurant\"\n}"}
          }
        },
        {
          "name": "Add Menu Item",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/owner/menu-items", "host": ["{{baseUrl}}"], "path": ["api", "owner", "menu-items"]},
            "body": {"mode": "raw", "raw": "{\n  \"poiId\": 1,\n  \"name\": \"Bún Bò Huế\",\n  \"price\": 45000,\n  \"currency\": \"VND\",\n  \"imageUrl\": \"https://example.com/bun-bo.jpg\",\n  \"displayOrder\": 1,\n  \"isAvailable\": true\n}"}
          }
        },
        {
          "name": "Add Images",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/owner/pois/1/images", "host": ["{{baseUrl}}"], "path": ["api", "owner", "pois", "1", "images"]},
            "body": {"mode": "raw", "raw": "[\n  \"https://example.com/image1.jpg\",\n  \"https://example.com/image2.jpg\"\n]"}
          }
        },
        {
          "name": "Get Dashboard Charts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/owner/dashboard/charts", "host": ["{{baseUrl}}"], "path": ["api", "owner", "dashboard", "charts"]}
          }
        },
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{ownerToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"]}
          }
        }
      ]
    },
    {
      "name": "4. Public POI & TTS & QR",
      "item": [
        {
          "name": "Get Approved POIs",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/pois", "host": ["{{baseUrl}}"], "path": ["api", "pois"]}
          }
        },
        {
          "name": "Get POI Menu",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/pois/1/menu", "host": ["{{baseUrl}}"], "path": ["api", "pois", "1", "menu"]}
          }
        },
        {
          "name": "Get POI Quiz",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/pois/1/quiz", "host": ["{{baseUrl}}"], "path": ["api", "pois", "1", "quiz"]}
          }
        },
        {
          "name": "Submit Quiz",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/quiz/submit", "host": ["{{baseUrl}}"], "path": ["api", "quiz", "submit"]},
            "body": {"mode": "raw", "raw": "{\n  \"quizQuestionId\": 1,\n  \"selectedOption\": \"A\"\n}"}
          }
        },
        {
          "name": "Scan QR",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/qr/MACodeTest", "host": ["{{baseUrl}}"], "path": ["api", "qr", "MACodeTest"]}
          }
        },
        {
          "name": "Add Translation (Triggers TTS)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/translations", "host": ["{{baseUrl}}"], "path": ["api", "translations"]},
            "body": {"mode": "raw", "raw": "{\n  \"poiId\": 1,\n  \"languageCode\": \"vi\",\n  \"name\": \"Ốc Oanh\",\n  \"shortDescription\": \"Quán ốc ngon.\",\n  \"fullDescription\": \"Quán ốc lâu đời nhất nhì Vĩnh Khánh.\",\n  \"audioText\": \"Chào mừng bạn đến với Ốc Oanh, quán ốc ngon nhất nhì khu phố ẩm thực Vĩnh Khánh. Hãy thưởng thức các món ốc đa dạng tại đây nhé!\"\n}"}
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001"
    },
    {
      "key": "ownerToken",
      "value": "YOUR_OWNER_JWT_HERE"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_HERE"
    }
  ]
}
